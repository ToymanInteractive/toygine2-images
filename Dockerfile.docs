# Doxygen and Graphviz on the GCC image (CMake, Ninja, the compiler) for toygine2's docs check.
#
# The docs target needs Doxygen 1.18.0 (trixie has 1.9.8), and upstream builds it for x86-64
# only, so this linux/amd64-only image stays out of the two-platform GCC and Clang images.
#
# Usage (same as the other toygine2 images):
#   docker build -t toygine2-docs - < Dockerfile.docs
#   docker run --rm --user "$(id -u):$(id -g)" -v "$PWD":/workspace -w /workspace toygine2-docs \
#       cmake --build --preset linux-debug --target docs

# Bumped by hand; the sha256 is the release asset's GitHub digest.
ARG DOXYGEN_VERSION=1.18.0
ARG DOXYGEN_SHA256=14fa81bdc34171edb5f1f02b1d60e74802f0439b77fa44e592565d517d72df90

# --- Stage 1: Doxygen fetch ---
# The GCC image already has curl and strip.
FROM ghcr.io/toymaninteractive/toygine2.gcc.toolchain:gcc-16.2.0 AS doxygen-fetch

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG DOXYGEN_VERSION
ARG DOXYGEN_SHA256

# Only bin/doxygen is kept, and strip saves 23 MB. Release tags use underscores; --no-same-owner
# drops the upstream runner's uid.
RUN tag="Release_$(echo "${DOXYGEN_VERSION}" | tr . _)" \
    && mkdir -p /tmp/doxygen && cd /tmp/doxygen \
    && curl -fSL --retry 3 -o doxygen.tgz \
    "https://github.com/doxygen/doxygen/releases/download/${tag}/doxygen-${DOXYGEN_VERSION}.linux.bin.tar.gz" \
    && { [ -z "${DOXYGEN_SHA256}" ] || echo "${DOXYGEN_SHA256}  doxygen.tgz" | sha256sum -c -; } \
    && tar -xzf doxygen.tgz --no-same-owner --strip-components=2 \
    "doxygen-${DOXYGEN_VERSION}/bin/doxygen" \
    && rm doxygen.tgz \
    && strip doxygen \
    && ./doxygen --version

# --- Stage 2: final image ---
FROM ghcr.io/toymaninteractive/toygine2.gcc.toolchain:gcc-16.2.0

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# graphviz: dot for the Doxyfile's HAVE_DOT graphs.
RUN apt-get update -qq && apt-get install -y --no-install-recommends graphviz \
    && rm -rf /var/lib/apt/lists/*

COPY --from=doxygen-fetch /tmp/doxygen/doxygen /usr/local/bin/doxygen

# Smoke test: render a call graph under WARN_AS_ERROR.
RUN mkdir -p /tmp/smoke && cd /tmp/smoke \
    && printf '%s\n' '/// @file' '/// @brief Smoke test.' '' \
    '/// @brief Returns the answer.' 'int answer() { return 42; }' '' \
    '/// @brief Calls answer().' 'int caller() { return answer(); }' > smoke.cpp \
    && printf '%s\n' 'INPUT = smoke.cpp' 'QUIET = YES' 'WARN_AS_ERROR = FAIL_ON_WARNINGS' \
    'HAVE_DOT = YES' 'CALL_GRAPH = YES' 'DOT_IMAGE_FORMAT = svg' 'GENERATE_LATEX = NO' \
    | doxygen - \
    && compgen -G 'html/*_cgraph.svg' \
    && doxygen --version && dot -V \
    && cd / && rm -rf /tmp/smoke

LABEL org.opencontainers.image.title="ToyGine2 Docs Toolchain"
LABEL org.opencontainers.image.description="Doxygen and Graphviz on the GCC toolchain for checking ToyGine2's documentation."
LABEL org.opencontainers.image.base.name="ghcr.io/toymaninteractive/toygine2.gcc.toolchain:gcc-16.2.0"

# The gcc, lcov and gh version labels come from the base.
LABEL com.toygine2.toolchain="Doxygen"

# Re-declare to bring the globally pinned value into this stage for the label below.
ARG DOXYGEN_VERSION
LABEL com.toygine2.sdk.doxygen.version="${DOXYGEN_VERSION}"
