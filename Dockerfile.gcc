# Latest stable GCC for building and testing ToyGine2 on Linux.
#
# Debian trixie has GCC 14 and Ubuntu 26.04 only a GCC 16 snapshot, so GCC (C and C++) is built
# from source into /usr/local and copied onto a slim base with CMake, Ninja, lcov and gh.
#
# Usage (same as the other toygine2 images):
#   docker build -t toygine2-gcc - < Dockerfile.gcc
#   docker run --rm --user "$(id -u):$(id -g)" -v "$PWD":/workspace -w /workspace toygine2-gcc \
#       cmake --preset linux-release

# Global so the final image can label it. The update workflow bumps both after checking the GNU
# signature.
ARG GCC_VERSION=16.2.0
ARG GCC_SHA256=e6738e29597f733270731aa90600f37ffdc045079dfc27ec7e8192cc81085c3e

# Bumped by hand from the release asset's digest; lcov has no update workflow.
ARG LCOV_VERSION=2.5
ARG LCOV_SHA256=7e5e5a154bd5f3557659c328cab376764e7abd238bb403c424472c296b175126

# GitHub CLI release and archive sha256s, the same in every Dockerfile; update_gh_release.yaml
# bumps them all at once.
ARG GH_VERSION=2.102.0
ARG GH_SHA256_AMD64=bb766f710eef8ede859c18578c72c327597cd4c8a85b06001b1f3843c6019386
ARG GH_SHA256_ARM64=7862c86c72f43df3a2d93ddde6f473285b4e2af61b494849846827e513ef6484

# --- Stage 1: GCC builder ---
FROM debian:trixie-slim AS gcc-builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# build-essential: GCC 14 builds the new GCC; flex/bison: GCC's generators; libgmp/mpfr/mpc/
# isl-dev: cc1 dependencies; libzstd-dev: compressed LTO; zlib1g-dev: --with-system-zlib.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    bison build-essential ca-certificates curl flex libgmp-dev libisl-dev libmpc-dev libmpfr-dev \
    libzstd-dev xz-utils zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

ARG GCC_VERSION
ARG GCC_SHA256

# No bootstrap: the new compiler builds libstdc++ and the other target libraries anyway, and a
# bootstrap would triple the build time for the same output. --disable-nls keeps CI diagnostics
# in English. MAKEINFO=true skips the info manuals.
RUN mkdir -p /tmp/gcc && cd /tmp/gcc \
    && curl -fSL --retry 3 -o gcc.tar.xz \
    "https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz" \
    && { [ -z "${GCC_SHA256}" ] || echo "${GCC_SHA256}  gcc.tar.xz" | sha256sum -c -; } \
    && tar -xf gcc.tar.xz \
    && mkdir build && cd build \
    && "../gcc-${GCC_VERSION}/configure" --prefix=/usr/local --enable-languages=c,c++ \
    --disable-multilib --disable-bootstrap --disable-nls --with-system-zlib --enable-default-pie \
    && make -j"$(nproc)" MAKEINFO=true \
    && make install-strip MAKEINFO=true \
    && cd / && rm -rf /tmp/gcc

# Smoke test: C++23 features GCC 14 lacks, run against the new libstdc++. The rpath is needed
# only here; the final image registers /usr/local/lib64 with the loader.
RUN printf '%s\n' '#include <expected>' '#include <print>' \
    'std::expected<int, int> answer() { return 42; }' \
    'int main() { std::print("{}\n", answer().value()); }' > /tmp/smoke.cpp \
    && g++ -std=c++23 -O2 -Wl,-rpath,/usr/local/lib64 /tmp/smoke.cpp -o /tmp/smoke \
    && [ "$(/tmp/smoke)" = 42 ] \
    && g++ --version \
    && rm /tmp/smoke /tmp/smoke.cpp

# --- Stage 2: lcov builder ---
FROM debian:trixie-slim AS lcov-builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# make/perl: lcov's install target runs fix.pl on each script.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    ca-certificates curl make perl \
    && rm -rf /var/lib/apt/lists/*

ARG LCOV_VERSION
ARG LCOV_SHA256

# Debian's lcov depends on gcc | llvm and would pull in GCC 14 (about 160 MB). install runs a
# phony Sphinx docs build; -o doc_finished skips it, as the tarball ships the docs prebuilt.
# PREFIX is baked into the scripts, so DESTDIR stages the tree. The rm drops docs, examples and
# self-tests the image does not use (about 8 MB).
RUN mkdir -p /tmp/lcov && cd /tmp/lcov \
    && curl -fSL --retry 3 -o lcov.tar.gz \
    "https://github.com/linux-test-project/lcov/releases/download/v${LCOV_VERSION}/lcov-${LCOV_VERSION}.tar.gz" \
    && { [ -z "${LCOV_SHA256}" ] || echo "${LCOV_SHA256}  lcov.tar.gz" | sha256sum -c -; } \
    && tar -xzf lcov.tar.gz && cd "lcov-${LCOV_VERSION}" \
    && make -o doc_finished install PREFIX=/usr/local DESTDIR=/opt/lcov \
    && cd /opt/lcov/usr/local/share \
    && rm -rf man lcov/html lcov/example lcov/tests \
    && cd / && rm -rf /tmp/lcov

# --- Stage 3: GitHub CLI fetch ---
# gh is a static Go binary, so this stage runs on the build platform and arm64 needs no emulation.
FROM --platform=$BUILDPLATFORM debian:trixie-slim AS gh-fetch

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The slim base has no curl.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

ARG GH_VERSION
ARG GH_SHA256_AMD64
ARG GH_SHA256_ARM64
ARG BUILDARCH
ARG TARGETARCH

# Asset names use Docker's arch names. --no-same-owner: the archive stores uid 1001, the runner
# user. Smoke test: --version runs only for the build platform's binary.
RUN case "${TARGETARCH}" in \
    amd64) sha256="${GH_SHA256_AMD64}" ;; \
    arm64) sha256="${GH_SHA256_ARM64}" ;; \
    *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2 && exit 1 ;; \
    esac \
    && name="gh_${GH_VERSION}_linux_${TARGETARCH}" \
    && mkdir -p /tmp/gh && cd /tmp/gh \
    && curl -fSL --retry 3 -o gh.tar.gz \
    "https://github.com/cli/cli/releases/download/v${GH_VERSION}/${name}.tar.gz" \
    && { [ -z "${sha256}" ] || echo "${sha256}  gh.tar.gz" | sha256sum -c -; } \
    && tar -xzf gh.tar.gz --no-same-owner --strip-components=2 "${name}/bin/gh" \
    && rm gh.tar.gz \
    && if [ "${TARGETARCH}" = "${BUILDARCH}" ]; then ./gh --version; fi

# --- Stage 4: final image ---
FROM debian:trixie-slim

# binutils/libc6-dev: assembler, linker, glibc; libgmp10/libisl23/libmpc3/libmpfr6/libzstd1: cc1
# runtime deps; make/cmake/ninja-build: the consumer presets; git/ca-certificates: actions/checkout
# needs git for submodules; curl/xz-utils/unzip: CI fetches tools inside the container; gpg/
# gpg-agent: signature checks (gpg --import fails without the agent; gnupg adds extras); python3:
# the benchmark step runs toygine2's tools/builder/bmf_from_csv.py; perl and its modules: lcov.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    binutils libc6-dev \
    libgmp10 libisl23 libmpc3 libmpfr6 libzstd1 \
    make cmake ninja-build git ca-certificates curl xz-utils unzip gpg gpg-agent python3 \
    perl libcapture-tiny-perl libdatetime-perl libtimedate-perl \
    && rm -rf /var/lib/apt/lists/*

# A mounted checkout is owned by the host user, so git as root fails with "dubious ownership".
# System-wide so --user uids (HOME=/) see it too.
RUN git config --system --add safe.directory '*'

COPY --from=gcc-builder /usr/local /usr/local
COPY --from=lcov-builder /opt/lcov/usr/local /usr/local

# Without this the loader picks Debian's older libstdc++.so.6 and tests fail with "GLIBCXX_3.4.x
# not found"; the new library is backward compatible, so system tools keep working. GCC installs
# no cc, which make's implicit rules call.
RUN echo /usr/local/lib64 > /etc/ld.so.conf.d/000-local.conf && ldconfig \
    && ln -s gcc /usr/local/bin/cc

COPY --from=gh-fetch /tmp/gh/gh /usr/local/bin/gh

ENV LANG=C.UTF-8

WORKDIR /workspace
CMD ["bash"]

LABEL org.opencontainers.image.authors="Toyman Interactive <https://github.com/ToymanInteractive>"
LABEL org.opencontainers.image.url="https://github.com/ToymanInteractive/toygine2-images"
LABEL org.opencontainers.image.documentation="https://github.com/ToymanInteractive/toygine2-images/blob/main/README.md"
LABEL org.opencontainers.image.source="https://github.com/ToymanInteractive/toygine2-images"

LABEL org.opencontainers.image.vendor="Toyman Interactive"
LABEL org.opencontainers.image.licenses="MIT"

LABEL org.opencontainers.image.title="ToyGine2 GCC Toolchain"
LABEL org.opencontainers.image.description="GCC toolchain for building ToyGine2 for Linux."
LABEL org.opencontainers.image.base.name="docker.io/library/debian:trixie-slim"

LABEL com.toygine2.toolchain="GCC"

# Re-declare to bring the globally pinned values into this stage for the labels below.
ARG GCC_VERSION
LABEL com.toygine2.sdk.gcc.version="${GCC_VERSION}"
ARG LCOV_VERSION
LABEL com.toygine2.sdk.lcov.version="${LCOV_VERSION}"
ARG GH_VERSION
LABEL com.toygine2.sdk.gh.version="${GH_VERSION}"
