# Image with the Libdragon toolchain for building ToyGine2 targeting Nintendo 64 (mips64-elf).
#
# Libdragon's prebuilt toolchain packages date from 2023, so the image builds everything from source
# in two stages:
#   stage1  toolchain  upstream tools/build-toolchain.sh: binutils, GCC (C/C++), newlib
#   stage2  library    libdragon itself plus its host tools (n64tool, mksprite, audioconv64, ...)
#
# Both stages install into /opt/libdragon (n64.mk finds it through N64_INST), and the final image
# copies only that directory and the GitHub CLI (gh) from a third stage.
#
# Usage (same as the other toygine2 images):
#   docker build -t toygine2-n64 - < Dockerfile.n64
#   docker run --rm -v "$PWD":/workspace -w /workspace toygine2-n64 \
#       make -C path/to/project

# Pinned upstream commits (global ARGs so the final image can expose them as metadata labels;
# both are bumped like dependencies by the update workflow).
#
# The toolchain and the library have separate pins. build-toolchain.sh changes far less often than
# the library, and GCC is the slowest part of the build, so a shared pin would rebuild the compiler
# on every library bump. LIBDRAGON_TOOLCHAIN_COMMIT moves only when the script changes, which keeps
# stage 1 cached.
ARG LIBDRAGON_TOOLCHAIN_COMMIT=39d0d6096130836a65710da6730290701d060272
ARG LIBDRAGON_COMMIT=39d0d6096130836a65710da6730290701d060272

# GitHub CLI release and archive sha256s, the same in every Dockerfile; update_gh_release.yaml
# bumps them all at once.
ARG GH_VERSION=2.102.0
ARG GH_SHA256_AMD64=bb766f710eef8ede859c18578c72c327597cd4c8a85b06001b1f3843c6019386
ARG GH_SHA256_ARM64=7862c86c72f43df3a2d93ddde6f473285b4e2af61b494849846827e513ef6484

# --- Stage 1: mips64-elf toolchain builder ---
FROM debian:trixie-slim AS toolchain-builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# build-essential/texinfo/patch build binutils, GCC and newlib (the script patches GCC's config.gcc
# for the N64 multilib layout); bzip2 unpacks GMP, the only source the script fetches as .tar.bz2;
# zlib1g-dev is needed for the script's --with-system-zlib; curl downloads the sources (the script
# uses wget when present, and the final image needs curl anyway); the GNU configure scripts call
# file.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential bzip2 ca-certificates curl file git patch texinfo zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Inherit the globally pinned toolchain commit declared above.
ARG LIBDRAGON_TOOLCHAIN_COMMIT

# build-toolchain.sh reads N64_INST, BUILD_PATH and DOWNLOAD_PATH from the environment. They stay
# set for stage 2, which builds the library against this prefix.
ENV N64_INST=/opt/libdragon
ENV BUILD_PATH=/tmp/toolchain
ENV DOWNLOAD_PATH=/tmp/toolchain-sources
ENV PATH="${N64_INST}/bin:${PATH}"

# binutils, GCC and newlib for mips64-elf, the longest part of the build.
# The clone sits in the same layer as the build, so its 120 MB go when the rm below runs. In a
# layer of its own it would stay in the exported buildcache, wherever it was deleted.
# The script downloads the source archives itself, without checksums, and takes their versions
# from the pinned script commit. It tees its log into BUILD_PATH before creating that directory,
# so this step creates it first. Locales are removed because the whole prefix goes into the final
# image and CI reads English diagnostics.
RUN mkdir -p /tmp/libdragon-toolchain \
    && cd /tmp/libdragon-toolchain \
    && git init -q \
    && git remote add origin https://github.com/DragonMinded/libdragon.git \
    && git fetch --depth 1 origin "${LIBDRAGON_TOOLCHAIN_COMMIT}" \
    && git checkout -q --detach FETCH_HEAD \
    && mkdir -p "${BUILD_PATH}" "${DOWNLOAD_PATH}" \
    && bash tools/build-toolchain.sh \
    && rm -rf "${BUILD_PATH}" "${DOWNLOAD_PATH}" /tmp/libdragon-toolchain "${N64_INST}"/share/locale/*

# --- Stage 2: libdragon library and host tools builder ---
# Builds on the toolchain stage: the library needs its compiler, and the host tools need the
# build-essential it already has.
FROM toolchain-builder AS library-builder

# Inherit the globally pinned library commit declared above.
ARG LIBDRAGON_COMMIT

# 1 = skip building the C++ example after install.
ARG SKIP_SMOKE_TEST=0

# libdragon.a, the headers, n64.mk and the host tools, installed into N64_INST.
# build.sh is upstream's own entry point; --no-examples leaves the examples to the smoke test.
# That test builds cpptest, the upstream C++ example, because ToyGine2 is written in C++.
# Clone, build and smoke test share one layer: the test needs the examples, so the tree can only
# be deleted once it has run.
RUN mkdir -p /tmp/libdragon \
    && cd /tmp/libdragon \
    && git init -q \
    && git remote add origin https://github.com/DragonMinded/libdragon.git \
    && git fetch --depth 1 origin "${LIBDRAGON_COMMIT}" \
    && git checkout -q --detach FETCH_HEAD \
    && ./build.sh --no-examples \
    && if [ "${SKIP_SMOKE_TEST}" != "1" ]; then \
    make -C examples/cpptest -j"$(nproc)" \
    && mips64-elf-g++ --version; \
    fi \
    && rm -rf /tmp/libdragon

# --- Stage 3: GitHub CLI fetch ---
# gh is a static Go binary, so this stage runs on the build platform and arm64 needs no emulation.
FROM --platform=$BUILDPLATFORM debian:trixie-slim AS gh-fetch

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The slim base has no curl.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

ARG GH_VERSION
ARG GH_SHA256_AMD64
ARG GH_SHA256_ARM64
ARG BUILDARCH
ARG TARGETARCH

# Asset names use Docker's arch names. --no-same-owner: the archive stores uid 1001, the runner
# user. Smoke test: --version runs only for the build platform's binary.
RUN case "${TARGETARCH}" in \
    amd64) sha256="${GH_SHA256_AMD64}" ;; \
    arm64) sha256="${GH_SHA256_ARM64}" ;; \
    *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2 && exit 1 ;; \
    esac \
    && name="gh_${GH_VERSION}_linux_${TARGETARCH}" \
    && mkdir -p /tmp/gh && cd /tmp/gh \
    && curl -fSL --retry 3 -o gh.tar.gz \
    "https://github.com/cli/cli/releases/download/v${GH_VERSION}/${name}.tar.gz" \
    && { [ -z "${sha256}" ] || echo "${sha256}  gh.tar.gz" | sha256sum -c -; } \
    && tar -xzf gh.tar.gz --no-same-owner --strip-components=2 "${name}/bin/gh" \
    && rm gh.tar.gz \
    && if [ "${TARGETARCH}" = "${BUILDARCH}" ]; then ./gh --version; fi

# --- Stage 4: final image ---
FROM debian:trixie-slim

# make: Makefile projects (n64.mk); cmake: toolchain.cmake; ninja-build: the consumer CMake presets
# use the Ninja generator; git and ca-certificates: actions/checkout runs git from the image itself,
# and without it checkout silently falls back to the REST API tarball, where 'submodules: recursive'
# becomes a hard error; curl/xz-utils/unzip: CI steps fetch and unpack tools inside the job
# container; python3: every toygine2 image has it for CI helper scripts such as
# tools/builder/bmf_from_csv.py; libstdc++6: the C++ host tools (mkfont, mksprite, mkmodel,
# audioconv64) link it.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    make cmake ninja-build git ca-certificates curl xz-utils unzip python3 \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# A mounted checkout is owned by the host user, so git as root fails with "dubious ownership".
# System-wide so --user uids (HOME=/) see it too.
RUN git config --system --add safe.directory '*'

COPY --from=library-builder /opt/libdragon /opt/libdragon
COPY --from=gh-fetch /tmp/gh/gh /usr/local/bin/gh

ENV LANG=C.UTF-8
ENV N64_INST=/opt/libdragon
ENV PATH="${N64_INST}/bin:${PATH}"

WORKDIR /workspace
CMD ["bash"]

LABEL org.opencontainers.image.authors="Toyman Interactive <https://github.com/ToymanInteractive>"
LABEL org.opencontainers.image.url="https://github.com/ToymanInteractive/toygine2-images"
LABEL org.opencontainers.image.documentation="https://github.com/ToymanInteractive/toygine2-images/blob/main/README.md"
LABEL org.opencontainers.image.source="https://github.com/ToymanInteractive/toygine2-images"

LABEL org.opencontainers.image.vendor="Toyman Interactive"
LABEL org.opencontainers.image.licenses="MIT"

LABEL org.opencontainers.image.title="ToyGine2 Nintendo 64 Toolchain"
LABEL org.opencontainers.image.description="Libdragon toolchain for building ToyGine2 targeting Nintendo 64."
LABEL org.opencontainers.image.base.name="docker.io/library/debian:trixie-slim"

LABEL com.toygine2.console="Nintendo 64"
LABEL com.toygine2.toolchain="Libdragon"

# Re-declare to bring the globally pinned values into this stage for the labels below.
ARG LIBDRAGON_TOOLCHAIN_COMMIT
ARG LIBDRAGON_COMMIT
LABEL com.toygine2.sdk.libdragon.toolchain.commit="${LIBDRAGON_TOOLCHAIN_COMMIT}"
LABEL com.toygine2.sdk.libdragon.commit="${LIBDRAGON_COMMIT}"
ARG GH_VERSION
LABEL com.toygine2.sdk.gh.version="${GH_VERSION}"
