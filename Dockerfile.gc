# Image with the devkitPro devkitPPC toolchain for building ToyGine2 targeting Nintendo GameCube.
#
# Thin wrapper over the upstream devkitpro/devkitppc image, pinned to a date tag and annotated
# with OCI labels for the toygine2 CI and registry. It adds no tooling: devkitPro already ships
# the cross-compiler and the platform libraries (libogc) that ToyGine2's Makefiles use.
#
# Usage (same as the other toygine2 images):
#   docker build -t toygine2-gc - < Dockerfile.gc
#   docker run --rm -v "$PWD":/workspace -w /workspace toygine2-gc \
#       make -C path/to/project

FROM devkitpro/devkitppc:20260503

LABEL org.opencontainers.image.authors="Toyman Interactive <https://github.com/ToymanInteractive>"
LABEL org.opencontainers.image.url="https://github.com/ToymanInteractive/toygine2-images"
LABEL org.opencontainers.image.documentation="https://github.com/ToymanInteractive/toygine2-images/blob/main/README.md"
LABEL org.opencontainers.image.source="https://github.com/ToymanInteractive/toygine2-images"

LABEL org.opencontainers.image.vendor="Toyman Interactive"
LABEL org.opencontainers.image.licenses="MIT"

LABEL org.opencontainers.image.title="ToyGine2 Gamecube Toolchain"
LABEL org.opencontainers.image.description="devkitPPC toolchain for building ToyGine2 targeting Nintendo GameCube."
LABEL org.opencontainers.image.base.name="docker.io/devkitpro/devkitppc:20260503"

LABEL com.toygine2.console="Nintendo GameCube"
LABEL com.toygine2.toolchain="devkitPPC"
